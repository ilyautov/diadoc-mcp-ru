{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ilyautov/diadoc-mcp-ru",
  "title": "Диадок MCP (RU) — ЭДО, документы, контрагенты",
  "description": "API Диадока в ИИ-ассистенте: документы ЭДО, контрагенты, подписание, МЧД",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/ilyautov/diadoc-mcp-ru",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "diadoc-mcp-ru",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DIADOC_CLIENT_ID",
          "description": "Идентификатор приложения Диадок, выдаёт Контур.",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "DIADOC_TOKEN",
          "description": "Токен пользователя Диадок, выдаёт метод Authenticate.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
